# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string.
# If left empty, the server starts an embedded in-memory MongoDB for local development.
MONGODB_URI=

# JWT signing secret (change in production)
JWT_SECRET=change-me-in-production

# Seed admin account (used by `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# ---- Optional LLM-based evaluation ----
# Provide YOUR OWN OpenAI-compatible key to enable the LLM evaluator.
# When empty the system falls back to an offline semantic/keyword evaluator.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini
